# Copy to .env.production only when overriding these non-secret deployment settings.
# Secrets belong in deploy/secrets/*.txt and must never be placed in this file.
TZ=Asia/Shanghai
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.4-alpine
OPENSEARCH_IMAGE=opensearchproject/opensearch:2.12.0
MYSQL_PORT=3306
REDIS_PORT=6379
OPENSEARCH_PORT=9200
CHATCHAT_REDIS_NODE=redis:6379
MYSQL_MAX_CONNECTIONS=300
MYSQL_INNODB_BUFFER_POOL_SIZE=1G
MYSQL_MEMORY_LIMIT=3G
REDIS_MEMORY_LIMIT=1G
REDIS_MAXMEMORY=768mb
OPENSEARCH_MEMORY_LIMIT=2G
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
