# Copy to .env.production only when overriding these non-secret deployment settings.
# Secrets belong in deploy/secrets/*.txt and must never be placed in this file.
TZ=Asia/Shanghai
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.4-alpine
OPENSEARCH_IMAGE=opensearchproject/opensearch:2.12.0
MYSQL_PORT=3306
REDIS_PORT=6379
OPENSEARCH_PORT=9200
CHATCHAT_REDIS_NODE=redis:6379
MYSQL_MAX_CONNECTIONS=300
MYSQL_INNODB_BUFFER_POOL_SIZE=1G
MYSQL_MEMORY_LIMIT=3G
REDIS_MEMORY_LIMIT=1G
REDIS_MAXMEMORY=768mb
OPENSEARCH_MEMORY_LIMIT=2G
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

# UI Artifact Store: use "local" for one node or "shared" for an OS-mounted NFSv4/SMB3/CephFS directory.
CHATCHAT_UI_ARTIFACT_STORE_TYPE=local
CHATCHAT_UI_ARTIFACT_STORAGE_PATH=./data/ui-artifacts
CHATCHAT_UI_ARTIFACT_TTL_SECONDS=2592000
CHATCHAT_UI_ARTIFACT_CLEANUP_INTERVAL_MS=3600000
# Linux NFS/CephFS example: CHATCHAT_UI_ARTIFACT_STORAGE_PATH=/mnt/chatchat-artifacts
# Windows SMB example: CHATCHAT_UI_ARTIFACT_STORAGE_PATH=\\fileserver\chatchat-artifacts
# Shared mode requires a .chatchat-artifact-store marker file at the mounted root.
