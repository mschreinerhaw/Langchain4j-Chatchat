# ChatChat API preset: OpenSearch + MySQL.
# Rename or copy this file to an application-*.yml file that Spring Boot loads.
# Example: application-prod.yml for production-like deployment.

spring:
  config:
    import: datasource-mysql.yml
  application:
    name: chatchat
    version: 1.0.0-SNAPSHOT
  web:
    resources:
      static-locations: classpath:/static/
  mvc:
    static-path-pattern: /**
    throw-exception-if-no-handler-found: true
  resources:
    add-mappings: false
  servlet:
    multipart:
      max-file-size: 5MB
      max-request-size: 32MB

server:
  port: 8080
  servlet:
    context-path: /
    encoding:
      charset: UTF-8
      enabled: true
      force: true
  shutdown: graceful
  tomcat:
    max-http-form-post-size: 33554432
    max-swallow-size: -1
  error:
    include-stacktrace: never
    include-message: never

chatchat:
  internal-credential:
    enabled: true
    username: chatchat_mcp_internal
    encrypted-secret:
    secret: chatchat_internal_default_secret
    crypto-key:
    crypto-key-file:
  mcp:
    center:
      enabled: true
      base-url: http://localhost:8090
      admin-username: chatchat_mcp_internal
      encrypted-admin-password:
      admin-password: chatchat_internal_default_secret
      encrypted-invocation-token:
      invocation-token: chatchat_internal_default_secret
      timeout-ms: 300000
      import-standalone-server: true
    stdio-proxy:
      enabled: true
      command-allow-list:
        - npx
        - node
        - uvx
        - python
        - python3
  models:
    defaultProvider: openai
    defaultChatModel: deepseek-v4-pro
    availableChatModels:
      - deepseek-v4-pro
    openai:
      apiKey:
      baseUrl: https://api.openai.com/v1
      timeout: 300000
      maxTokens: -1
      maxRetries: 3
  search:
    engine: opensearch
    store-path: ./data/search-rocksdb
    file-path: ./data/search-files
    rebuild-on-startup: false
    opensearch:
      enabled: true
      url: https://localhost:9200
      username: admin
      password:
      index-name: chatchat_documents
      insecure-ssl: true
      connect-timeout-ms: 5000
      request-timeout-ms: 30000
      bulk-batch-size: 200
      max-query-terms: 20
      max-query-chars: 500
      max-permission-roles: 64
      log-query-dsl: false
      embedding:
        request-timeout-ms: 300000
        enabled: false
        endpoint:
        api-key:
        model: text-embedding-v4
        dimension: 1024
        vector-field: contentVector
        max-input-chars: 6000
        vector-candidate-limit: 50
  tools:
    document-search:
      api-base-url: http://localhost:8080
      auth:
        username: chatchat_mcp_internal
        encrypted-password:
        password: chatchat_internal_default_secret
        bearer-token:

springdoc:
  api-docs:
    path: /api-docs
    enabled: true
  swagger-ui:
    enabled: false

logging:
  charset:
    console: UTF-8
    file: UTF-8
  file:
    name: logs/chatchat.log
  level:
    com.chatchat: INFO
    org.springframework.web: INFO
    org.springframework.security: INFO
    org.hibernate: WARN

management:
  endpoints:
    web:
      exposure:
        include: health,metrics,info
