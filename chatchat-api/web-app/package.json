{
  "name": "chatchat-web-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:ui-artifact",
    "test:ui-artifact": "vitest run src/js/utils/resultTableEnhancer.test.js src/js/utils/artifactPresentationStyles.test.js src/js/utils/displayContractRegression.test.js",
    "test:ui-artifact:visual": "node scripts/test-ui-artifact-visual.mjs",
    "verify:ui-artifact": "npm run test:ui-artifact && npm run test:ui-artifact:visual && npm run build",
    "verify": "npm run test && npm run build"
  },
  "dependencies": {
    "@json-render/core": "^0.19.0",
    "@json-render/vue": "^0.19.0",
    "@lucide/vue": "^1.17.0",
    "docx-preview": "^0.3.7",
    "echarts": "^6.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "markdown-it": "^14.2.0",
    "pdfjs-dist": "^6.0.227",
    "vue": "^3.5.22",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.54.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
