{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report_block.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "chartType", "datasetRef", "encoding", "title", "conclusion", "reason"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9:_-]{1,64}$" },
    "type": { "enum": ["chart", "table", "metric"] },
    "chartType": { "type": "string" },
    "datasetRef": { "type": "string", "minLength": 1, "maxLength": 200 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "conclusion": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 400 },
    "evidenceRefs": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 200 } },
    "encoding": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "x": { "type": "string", "maxLength": 256 },
        "y": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "maxLength": 256 } },
        "columns": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "maxLength": 256 } }
      }
    }
  }
}
