# Copy this file to config/license-center.env and restrict its permissions:
#   chmod 600 config/license-center.env

CHATCHAT_LICENSE_CENTER_USERNAME=license-admin
CHATCHAT_LICENSE_CENTER_PASSWORD=replace-with-a-strong-password
CHATCHAT_LICENSE_CENTER_PORT=8092

# H2 authorization audit database. Use an absolute path in production when possible.
CHATCHAT_LICENSE_DB_URL=jdbc:h2:file:./data/license-center/license-audit;MODE=MySQL;DATABASE_TO_LOWER=TRUE;AUTO_SERVER=TRUE
CHATCHAT_LICENSE_DB_USERNAME=sa
# Default password for first-time startup. Replace it with a unique strong value in production.
CHATCHAT_LICENSE_DB_PASSWORD=LiveMCP_H2#Audit@2026!Secure

# Keep the signing private key inside the enterprise License Center only.
CHATCHAT_LICENSE_PRIVATE_KEY_PATH=./data/license-center/license-private.pem
CHATCHAT_LICENSE_PUBLIC_KEY_PATH=./data/license-center/license-public.pem
CHATCHAT_LICENSE_AUTO_GENERATE_KEYS=true
CHATCHAT_LICENSE_KEY_ID=prod-2026

# MCP Server menu catalog used by the issuance page.
CHATCHAT_MCP_MENU_CATALOG_URL=http://127.0.0.1:8090/api/v1/license/menu-catalog
CHATCHAT_MCP_MENU_CATALOG_TIMEOUT_MS=5000

# Optional JVM tuning. The startup script defaults to -Xms256m -Xmx512m.
# JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC
