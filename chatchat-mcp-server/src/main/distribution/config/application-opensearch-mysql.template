# ChatChat MCP Server preset: OpenSearch + MySQL.
# Rename or copy this file to an application-*.yml file in the distribution config directory.
# Example: application-prod.yml for production-like deployment.

spring:
  config:
    import: datasource-mysql.yml
  application:
    name: chatchat-mcp-server

server:
  port: 8090
  servlet:
    context-path: /
  shutdown: graceful

chatchat:
  internal-credential:
    enabled: true
    username: chatchat_mcp_internal
    encrypted-secret: "${CHATCHAT_INTERNAL_ENCRYPTED_SECRET:}"
    crypto-key-file: ./config/internal-credential.key
  mcp:
    grpc:
      client: { enabled: false }
      server:
        enabled: ${CHATCHAT_MCP_GRPC_SERVER_ENABLED:true}
        port: ${CHATCHAT_MCP_GRPC_PORT:9091}
        chunk-bytes: ${CHATCHAT_MCP_GRPC_CHUNK_BYTES:1048576}
        max-inbound-message-bytes: ${CHATCHAT_MCP_GRPC_MAX_REQUEST_BYTES:67108864}
        plaintext: ${CHATCHAT_MCP_GRPC_PLAINTEXT:true}
        certificate-chain-path: ${CHATCHAT_MCP_GRPC_CERT_CHAIN:}
        private-key-path: ${CHATCHAT_MCP_GRPC_PRIVATE_KEY:}
    news-runtime:
      base-url: http://localhost:8091
      timeout-millis: ${CHATCHAT_NEWS_RUNTIME_TIMEOUT_MILLIS:20000}
    capabilities:
      news:
        enabled: true
        tools:
          web_search: { enabled: true, agent-callable: true, timeout: 30s }
    admin:
      token-ttl-minutes: 480
    security:
      require-mcp-token: true
      encrypted-invocation-token: "${CHATCHAT_MCP_ENCRYPTED_INVOCATION_TOKEN:${chatchat.internal-credential.encrypted-secret:}}"
    authorization:
      enabled: true
      api-base-url: http://localhost:8080
      auth:
        username: chatchat_mcp_internal
        encrypted-password: "${CHATCHAT_MCP_API_ENCRYPTED_PASSWORD:${chatchat.internal-credential.encrypted-secret:}}"
        bearer-token:
    command-templates:
      seed-defaults-enabled: true
    sql-templates:
      seed-defaults-enabled: true
    lucene:
      enabled: true
      engine: opensearch
      index-dir: ./data/lucene/mcp
      open-search:
        enabled: true
        url: https://localhost:9200
        username: admin
        password:
        index-prefix: chatchat_mcp_
        insecure-ssl: true
        request-timeout-ms: 30000
        debug-search: false
        search-concurrency:
          enabled: true
          request-timeout-ms: 8000
          retry-429-attempts: 1
          retry-backoff-min-ms: 100
          retry-backoff-max-ms: 300
          lexical:
            max-running: 12
            queue-capacity: 30
            queue-timeout-ms: 1500
          vector:
            max-running: 4
            queue-capacity: 10
            queue-timeout-ms: 500
        embedding:
          request-timeout-ms: 300000
          enabled: false
          endpoint:
          api-key:
          model: text-embedding-v4
          dimension: 1024
          vector-field: mcpContentVector
          max-input-chars: 6000
          vector-candidate-limit: 50
    server:
      endpoint: /mcp
      document-search:
        api-base-url: http://localhost:8080
        auth:
          username: chatchat_mcp_internal
          encrypted-password: "${CHATCHAT_MCP_API_ENCRYPTED_PASSWORD:${chatchat.internal-credential.encrypted-secret:}}"
          bearer-token:
  tools:
    document-search:
      enabled: true
      api-base-url: http://localhost:8080
      auth:
        username: chatchat_mcp_internal
        encrypted-password: "${CHATCHAT_MCP_API_ENCRYPTED_PASSWORD:${chatchat.internal-credential.encrypted-secret:}}"
        bearer-token:
logging:
  file:
    name: ./logs/chatchat-mcp-server.log
  level:
    root: INFO
    com.chatchat: INFO
    io.modelcontextprotocol: INFO
    org.springframework.boot.autoconfigure: WARN
    org.hibernate: WARN
