# Copy outside Git, replace paths/images with this installation's approved values.
STAGE_ROOT=/opt/runtime-os
API_IMAGE=runtime-os-api:RELEASE_TAG
MCP_IMAGE=runtime-os-mcp:RELEASE_TAG
NEWS_IMAGE=runtime-os-news:RELEASE_TAG
NODE_IMAGE=runtime-os-coding-agent:RELEASE_TAG
NODE_PROXY_IMAGE=nginx:1.27.5-alpine
POSTGRESQL_IMAGE=postgres:16.9
REDIS_IMAGE=redis:7.4-alpine
OPENSEARCH_IMAGE=opensearchproject/opensearch:2.12.0
API_DATA_DIR=/opt/runtime-os/api/data
MCP_DATA_DIR=/opt/runtime-os/mcp/data
NEWS_DATA_DIR=/opt/runtime-os/news/data
NEWS_CONFIG_DIR=/opt/runtime-os/news/config
MODEL_CONFIG_FILE=/opt/runtime-os/config/application.yml
MCP_HOST_MAC_FILE=/sys/class/net/ens192/address
API_INTERNAL_KEY_FILE=/opt/runtime-os/secrets/api-internal.key
MCP_INTERNAL_KEY_FILE=/opt/runtime-os/secrets/mcp-internal.key
CODING_AGENT_SHARED_SECRET_FILE=/opt/runtime-os/secrets/coding-shared
CODING_AGENT_NODE_SECRET_FILE=/opt/runtime-os/secrets/coding-node
POSTGRESQL_ADMIN_PASSWORD_FILE=/opt/runtime-os/secrets/postgresql-admin
POSTGRESQL_API_PASSWORD_FILE=/opt/runtime-os/secrets/postgresql-api
POSTGRESQL_MCP_PASSWORD_FILE=/opt/runtime-os/secrets/postgresql-mcp
REDIS_PASSWORD_FILE=/opt/runtime-os/secrets/redis
OPENSEARCH_ADMIN_PASSWORD_FILE=/opt/runtime-os/secrets/opensearch-admin
BOOTSTRAP_ADMIN_PASSWORD_FILE=/opt/runtime-os/secrets/bootstrap-admin
OPENSEARCH_CERTS_DIR=/opt/runtime-os/secrets/opensearch-certs
OPENSEARCH_TRUSTSTORE_FILE=/opt/runtime-os/config/opensearch-truststore.p12
POSTGRESQL_PORT=15432
REDIS_PORT=16379
OPENSEARCH_PORT=19200
PUBLIC_BIND_ADDRESS=0.0.0.0
RUNTIME_HTTP_PORT=18100
MCP_HTTP_PORT=18101
CODING_NATIVE_SDK_ENABLED=false
