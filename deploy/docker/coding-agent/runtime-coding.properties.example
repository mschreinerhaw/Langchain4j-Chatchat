# Import this deployment-owned file from the API's external Spring configuration.
# Provision the same 32+ character secret file for Java and the Coding container.
chatchat.coding.enabled=true
chatchat.coding.cline.enabled=true
chatchat.coding.cline.node-url=http://127.0.0.1:8791
chatchat.coding.cline.allowed-peer-addresses=127.0.0.1
chatchat.coding.cline.shared-secret-file=/opt/runtime-coding/config/shared-secret
chatchat.coding.analysis.enabled=true
# Required: select an actual PUBLISHED environment whose networkPolicy is NONE.
chatchat.coding.analysis.environment-id=${CODING_PYTHON_ENVIRONMENT_ID}
chatchat.coding.analysis.max-concurrent-tasks=2
chatchat.coding.analysis.timeout-seconds=300
chatchat.coding.analysis.max-model-calls=12
chatchat.coding.analysis.max-model-tokens=65536
chatchat.coding.analysis.max-code-executions=12
chatchat.coding.analysis.max-tool-calls=24
chatchat.coding.analysis.max-input-rows=100000
chatchat.coding.analysis.max-input-bytes=16777216
# Capacity opt-in: values above the two defaults use 4 MiB immutable chunks and a manifest.
# Hard limits: 1,000,000 rows, 256 MiB total, 64 chunks; each source row must fit one chunk.
# Size Python workspace storage for the entire mounted input set before enabling this profile.
# chatchat.coding.analysis.max-input-rows=1000000
# chatchat.coding.analysis.max-input-bytes=268435456
chatchat.coding.analysis.max-result-rows=10000
chatchat.coding.analysis.max-result-bytes=4194304

# Optional SQL AND Python workspace profiles, on the SAME CodingAgentSPI/Adapter/Node worker.
# Install the pinned sql-toolchain/requirements.txt into a deployment-owned Python venv first.
# No generated Python or SQL is executed by this parser entrypoint.
chatchat.coding.workspace.enabled=false
chatchat.coding.workspace.sqlglot-python=/opt/runtime-coding/sql-toolchain/bin/python
chatchat.coding.workspace.timeout-seconds=300

# Optional Java-authorized dynamic data supply. Empty grants confer no acquisition capability.
# Grants are deployment policy, never model parameters. Live Skill permissions are rechecked.
chatchat.coding.analysis.data-supply.enabled=false
chatchat.coding.analysis.data-supply.max-rounds=4
# Example only; replace identifiers with authorized existing tenant/user/Skill/template bindings.
# chatchat.coding.analysis.data-supply.grants[0].tenant-id=tenant-example
# chatchat.coding.analysis.data-supply.grants[0].user-id=user-example
# chatchat.coding.analysis.data-supply.grants[0].skill-id=authorized-finance-skill
# chatchat.coding.analysis.data-supply.grants[0].template-id=published-ledger-template
# chatchat.coding.analysis.data-supply.grants[0].asset-name=authorized-logical-asset
# chatchat.coding.analysis.data-supply.grants[0].environment=production
# chatchat.coding.analysis.data-supply.grants[0].parameter-values[tradeDate][0]=2026-10-13
# chatchat.coding.analysis.data-supply.grants[0].required-fields[0]=tradeDate
# chatchat.coding.analysis.data-supply.grants[0].required-fields[1]=amount
