SPRING_PROFILES_ACTIVE=prod
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
CHATCHAT_DATASOURCE_CONFIG=datasource-postgresql.yml
TZ=Asia/Shanghai
LANG=C.UTF-8
LC_ALL=C.UTF-8
CHATCHAT_AGENT_TASK_DATABASE_QUEUE_ENABLED=true
CHATCHAT_AGENT_TASK_EVENT_STORE_TYPE=database
CHATCHAT_AGENT_TASK_CORE_POOL_SIZE=2
CHATCHAT_AGENT_TASK_MAX_POOL_SIZE=2
CHATCHAT_AGENT_TASK_WORKER_HEARTBEAT_MS=5000
CHATCHAT_AGENT_TASK_WORKER_LEASE_MS=30000
CHATCHAT_CHAT_TASK_CLASSIFICATION_MAX_OUTPUT_TOKENS=4096
CHATCHAT_CHAT_DETAIL_STORE_PATH=/srv/app/data/chat-rocksdb
CHATCHAT_CHAT_DETAIL_STORE_EXTERNAL_TEXT_ENABLED=true
CHATCHAT_CHAT_DETAIL_STORE_EXTERNAL_TEXT_MIGRATE_LEGACY_ON_READ=false
CHATCHAT_UI_ARTIFACT_STORAGE_PATH=/srv/app/data/ui-artifacts
CHATCHAT_CODING_WORKSPACE_FAST_PATH_ENABLED=true
CHATCHAT_CODING_INPUT_WORKSPACE_FAST_PATH_ENABLED=false
CHATCHAT_CODING_INPUT_FILES_FORMAT=PARQUET
CHATCHAT_CODING_INPUT_FILES_SHARED_ROOT=/srv/shared-coding-input
CHATCHAT_CODING_ANALYSIS_TIMEOUT_SECONDS=1200
CHATCHAT_CODING_ANALYSIS_MAX_MODEL_TOKENS=786432
CHATCHAT_CODING_CLINE_MAX_MODEL_RESPONSE_REPAIRS=2
CHATCHAT_CODING_CLINE_MAX_OUTPUT_TOKENS=32768
# Fill with the published Python environment ID for this customer when required.
CHATCHAT_CODING_ANALYSIS_ENVIRONMENT_ID=
CHATCHAT_SEARCH_OPENSEARCH_INDEX=runtime_os_documents
CHATCHAT_SEARCH_OPENSEARCH_KNOWLEDGEINDEXNAMES=runtime_os_documents
CHATCHAT_SEARCH_OPENSEARCH_INSECURE_SSL=false
CHATCHAT_TOOLS_DOCUMENT_SEARCH_API_BASE_URL=http://api:8080
SPRING_APPLICATION_JSON='{"chatchat":{"coding":{"workspace":{"enabled":true,"sqlglot-python":"/usr/bin/python3"}}}}'
