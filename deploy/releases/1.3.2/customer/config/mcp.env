SPRING_PROFILES_ACTIVE=prod
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
CHATCHAT_DATASOURCE_CONFIG=datasource-postgresql.yml
TZ=Asia/Shanghai
LANG=C.UTF-8
LC_ALL=C.UTF-8
CHATCHAT_MCP_GRPC_PORT=9091
CHATCHAT_MCP_AUTHORIZATION_API_BASE_URL=http://api:8080
CHATCHAT_MCP_NEWS_RUNTIME_BASE_URL=http://news:8091
CHATCHAT_MCP_PYTHON_SHARED_INPUTS_ENABLED=true
CHATCHAT_MCP_PYTHON_DATA_ROOT=/opt/runtime-os-docker-stage/mcp/data/python-user-data
CHATCHAT_MCP_PYTHON_WORKSPACE_ROOT=/opt/runtime-os-docker-stage/mcp/data/python-assets
