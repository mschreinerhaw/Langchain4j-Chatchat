# Install on a new Linux host at /opt/runtime-os/releases/1.3.2/private/release.env.
# Keep the private runtime files in the same directory as this env file.
RUNTIME_CONFIG_DIR=/opt/runtime-os/releases/1.3.2/private
HUB_TOKEN=
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_API_PORT=18100
GATEWAY_MCP_PORT=18101
