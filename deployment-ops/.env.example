DB_PASSWORD=replace-with-local-h2-password
EXECUTOR_TOKEN=replace-with-64-character-random-secret
ADMIN_PASSWORD=replace-with-admin-password
OPS_BIND=127.0.0.1
OPS_PORT=19220
# Start with read-only discovery. An administrator must explicitly set 0 to enable writes.
OPS_READ_ONLY=1
# Comma-separated private registry hosts, e.g. registry.internal:5000
OPS_ALLOWED_REGISTRIES=
