[Unit]
Description=Deployment Ops single JAR (use --install-service to generate pinned paths)
After=network.target
RequiresMountsFor=/opt/deployment-ops

[Service]
Type=simple
EnvironmentFile=/opt/deployment-ops/manager.env
ExecStart=/usr/bin/java -jar /opt/deployment-ops/lib/deployment-ops.jar
Restart=on-failure
TimeoutStopSec=45
SuccessExitStatus=143
KillMode=process
UMask=0077

[Install]
WantedBy=multi-user.target
