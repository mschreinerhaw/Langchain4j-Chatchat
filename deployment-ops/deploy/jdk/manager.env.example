OPS_DATA_DIR=/opt/deployment-ops/data
OPS_RUNTIME_DIR=/opt/deployment-ops/r
# Optional: require a real dedicated mount. Leave unset for single-disk hosts.
# OPS_REQUIRED_MOUNT=/mnt/disk01
OPS_PORT=19240
OPS_EXECUTOR_PORT=19242
OPS_BIND=0.0.0.0
# No preset administrator password. Create it in the first-install page.
# The local executor listens only on loopback; do not expose its port.
