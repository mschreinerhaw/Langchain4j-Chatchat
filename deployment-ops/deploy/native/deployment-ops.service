[Unit]
Description=Runtime OS Deployment Manager (native Spring Boot control plane)
After=local-fs.target network.target
RequiresMountsFor=/mnt/disk01

[Service]
Type=simple
User=deployment-ops
Group=deployment-ops
WorkingDirectory=/opt/deployment-ops
EnvironmentFile=/etc/deployment-ops/manager.env
ExecStart=/bin/sh /opt/deployment-ops/deploy/native/start.sh
StandardOutput=append:/mnt/disk01/deployment-ops/logs/platform.log
StandardError=append:/mnt/disk01/deployment-ops/logs/platform.log
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/disk01/deployment-ops

[Install]
WantedBy=multi-user.target
