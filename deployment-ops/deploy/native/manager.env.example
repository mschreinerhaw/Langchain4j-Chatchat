# Install as /etc/deployment-ops/manager.env, owner root:deployment-ops, mode 0640.
# This file is parsed by systemd, not sourced by the launcher.
OPS_HOME=/opt/deployment-ops
OPS_DATA_MOUNT=/mnt/disk01
OPS_DATA_DIR=/mnt/disk01/deployment-ops/data
OPS_BIND=127.0.0.1
OPS_PORT=19240
# Set a private database password before first production startup.
# OPS_DB_PASSWORD=
