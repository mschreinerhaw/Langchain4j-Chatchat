  "parameters": {
    "serverAddress": {
      "label": "\u670d\u52a1\u5668\u8bbf\u95ee\u5730\u5740",
      "type": "string",
      "default": "127.0.0.1",
      "pattern": "[A-Za-z0-9.-]+"
    },
    "httpPort": {
      "label": "Runtime OS \u5165\u53e3\u7aef\u53e3",
      "type": "integer",
      "default": 19400,
      "min": 1024,
      "max": 65535
    },
    "mcpPort": {
      "label": "MCP \u5165\u53e3\u7aef\u53e3",
      "type": "integer",
      "default": 19401,
      "min": 1024,
      "max": 65535
    },
    "directoryName": {
      "label": "\u90e8\u7f72\u76ee\u5f55\u540d\uff08\u53ef\u9009\uff09",
      "type": "string",
      "default": "",
      "pattern": "([a-z0-9][a-z0-9-]{0,15})?",
      "description": "\u76ee\u5f55\u56fa\u5b9a\u5728 /mnt/disk01/ops/r \u4e0b\uff1b\u7559\u7a7a\u751f\u6210\u72ec\u7acb\u76ee\u5f55\uff0c\u5df2\u6709\u73af\u5883\u4e0d\u5141\u8bb8\u53d8\u66f4\u6570\u636e\u6839\u76ee\u5f55\u3002"
    },
    "osAdminPassword": {
      "label": "Runtime OS \u7ba1\u7406\u5458\u521d\u59cb\u5bc6\u7801",
      "type": "string",
      "secret": true,
      "required": true,
      "pattern": "[A-Za-z0-9_!@#%+.,:-]{12,128}",
      "description": "\u9996\u6b21\u90e8\u7f72\u8bbe\u7f6e 12\u2013128 \u4f4d\u5bc6\u7801\uff0cOS \u548c MCP \u5171\u7528\u521d\u59cb\u7ba1\u7406\u5458\u51ed\u636e\u3002\u5347\u7ea7\u65f6\u7559\u7a7a\u4fdd\u7559\u539f\u51ed\u636e\u3002"
