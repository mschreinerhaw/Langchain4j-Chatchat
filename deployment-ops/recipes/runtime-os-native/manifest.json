{
  "schemaVersion": 1,
  "name": "runtime-os",
  "version": "1.0.0-native-20261116",
  "platform": "linux/amd64",
  "description": "Native/Temporal Runtime OS: persistent workflow engine, API/MCP/News, restricted Core/Python executors, recovery nodes and application frontend. Uses the reviewed source-built product installer. No SDK substitute, online pull, customer data or production secrets.",
  "requirements": {
    "memoryBytes": 8589934592,
    "diskBytes": 12884901888
  },
  "upgradeFrom": [],
