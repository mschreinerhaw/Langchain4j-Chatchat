chatchat.models.chat-models[Qwen3-32B-A3B].model-name=${CHATCHAT_QWEN3_32B_A3B_MODEL_ID:/models/Qwen3-32B-A3B}
chatchat.models.chat-models[Qwen3-32B-A3B].api-key=${CHATCHAT_INTERNAL_MODEL_API_KEY:no-key}
chatchat.models.chat-models[Qwen3-32B-A3B].base-url=${CHATCHAT_QWEN3_32B_A3B_BASE_URL:http://127.0.0.1:32000/v1}
chatchat.models.chat-models[Qwen3-32B-A3B].protocol=openai
