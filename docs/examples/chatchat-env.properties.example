# Copy this file to <ChatChat installation directory>/config/env.properties.
# Use forward slashes on Linux. On Windows, use a path such as C:/Java/jdk-17.
JAVA_HOME=/opt/jdk-17
JAVA_OPTS=-Xms2g -Xmx4g -XX:+UseG1GC -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=./logs -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8

# Global model/context settings.
chatchat.models.default-chat-model=DeepSeek-V4.1-Flash
chatchat.models.context-window-max-tokens=200000
chatchat.models.context-reserved-system-tokens=20000
chatchat.models.context-reserved-history-tokens=30000
chatchat.models.context-reserved-output-tokens=30000

# Models exposed to the frontend.
chatchat.models.available-chat-models[0]=Qwen3-32B
chatchat.models.available-chat-models[1]=Qwen3.8-27B
chatchat.models.available-chat-models[2]=DeepSeek-V4.1-Flash
chatchat.models.available-chat-models[3]=DeepSeek-V4-Flash-int8
chatchat.models.available-chat-models[4]=Qwen3.6-35B-A3B
chatchat.models.available-chat-models[5]=Qwen3-VL-8B-Instruct
chatchat.models.available-chat-models[6]=Qwen3-32B-A3B

# Qwen3-32B
chatchat.models.chat-models[Qwen3-32B].model-name=${CHATCHAT_QWEN3_32B_MODEL_ID:/models/Qwen3-32B}
chatchat.models.chat-models[Qwen3-32B].api-key=${CHATCHAT_INTERNAL_MODEL_API_KEY:no-key}
chatchat.models.chat-models[Qwen3-32B].base-url=${CHATCHAT_QWEN3_32B_BASE_URL:http://127.0.0.1:31000/v1}
chatchat.models.chat-models[Qwen3-32B].protocol=openai
chatchat.models.chat-models[Qwen3-32B].timeout=1800000
chatchat.models.chat-models[Qwen3-32B].max-tokens=-1
chatchat.models.chat-models[Qwen3-32B].max-retries=1

# Qwen3.8-27B
chatchat.models.chat-models[Qwen3.8-27B].model-name=${CHATCHAT_QWEN3_8_27B_MODEL_ID:/models/Qwen3.8-27B}
chatchat.models.chat-models[Qwen3.8-27B].api-key=${CHATCHAT_INTERNAL_MODEL_API_KEY:no-key}
chatchat.models.chat-models[Qwen3.8-27B].base-url=${CHATCHAT_QWEN3_8_27B_BASE_URL:http://127.0.0.1:31002/v1}
chatchat.models.chat-models[Qwen3.8-27B].protocol=openai
chatchat.models.chat-models[Qwen3.8-27B].timeout=1800000
chatchat.models.chat-models[Qwen3.8-27B].max-tokens=-1
chatchat.models.chat-models[Qwen3.8-27B].max-retries=1

# DeepSeek-V4.1-Flash
chatchat.models.chat-models[DeepSeek-V4.1-Flash].model-name=${CHATCHAT_DEEPSEEK_V4_1_FLASH_MODEL_ID:/models/DeepSeek-V4.1-Flash}
chatchat.models.chat-models[DeepSeek-V4.1-Flash].api-key=${CHATCHAT_INTERNAL_MODEL_API_KEY:no-key}
chatchat.models.chat-models[DeepSeek-V4.1-Flash].base-url=${CHATCHAT_DEEPSEEK_V4_1_FLASH_BASE_URL:http://127.0.0.1:31005/v1}
chatchat.models.chat-models[DeepSeek-V4.1-Flash].protocol=openai
chatchat.models.chat-models[DeepSeek-V4.1-Flash].timeout=1800000
chatchat.models.chat-models[DeepSeek-V4.1-Flash].max-tokens=-1
chatchat.models.chat-models[DeepSeek-V4.1-Flash].max-retries=1

# DeepSeek-V4-Flash-int8
chatchat.models.chat-models[DeepSeek-V4-Flash-int8].model-name=${CHATCHAT_DEEPSEEK_V4_FLASH_INT8_MODEL_ID:/models/DeepSeek-V4-Flash-int8}
chatchat.models.chat-models[DeepSeek-V4-Flash-int8].api-key=${CHATCHAT_INTERNAL_MODEL_API_KEY:no-key}
