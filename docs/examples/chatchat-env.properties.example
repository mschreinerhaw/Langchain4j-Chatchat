chatchat.models.chat-models[DeepSeek-V4-Flash-int8].max-tokens=-1
chatchat.models.chat-models[DeepSeek-V4-Flash-int8].max-retries=1

# Qwen3.6-35B-A3B
chatchat.models.chat-models[Qwen3.6-35B-A3B].model-name=${CHATCHAT_QWEN3_6_35B_A3B_MODEL_ID:/models/Qwen3.6-35B-A3B}
chatchat.models.chat-models[Qwen3.6-35B-A3B].api-key=${CHATCHAT_INTERNAL_MODEL_API_KEY:no-key}
