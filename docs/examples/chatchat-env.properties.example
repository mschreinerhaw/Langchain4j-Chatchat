chatchat.models.chat-models[Qwen3-VL-8B-Instruct].api-key=${CHATCHAT_INTERNAL_MODEL_API_KEY:no-key}
chatchat.models.chat-models[Qwen3-VL-8B-Instruct].base-url=${CHATCHAT_QWEN3_VL_8B_BASE_URL:http://127.0.0.1:32002/v1}
chatchat.models.chat-models[Qwen3-VL-8B-Instruct].protocol=openai
chatchat.models.chat-models[Qwen3-VL-8B-Instruct].timeout=1800000
