# OS environment variables loaded by systemd EnvironmentFile.
# Install as /etc/chatchat/chatchat-api.env and chmod 600.

# Required secret. Replace it before deployment.
CHATCHAT_INTERNAL_MODEL_API_KEY=replace-with-real-token

# Optional: use a non-default Spring override file.
# CHATCHAT_ENV_PROPERTIES_LOCATION=/opt/chatchat/config/env.properties

# Optional provider model-id overrides. The defaults are defined in env.properties.
# Confirm every value against the corresponding /v1/models response.
CHATCHAT_QWEN3_32B_MODEL_ID=/models/Qwen3-32B
CHATCHAT_QWEN3_8_27B_MODEL_ID=/models/Qwen3.8-27B
CHATCHAT_DEEPSEEK_V4_1_FLASH_MODEL_ID=/models/DeepSeek-V4.1-Flash
CHATCHAT_DEEPSEEK_V4_FLASH_INT8_MODEL_ID=/models/DeepSeek-V4-Flash-int8
CHATCHAT_QWEN3_6_35B_A3B_MODEL_ID=/models/Qwen3.6-35B-A3B
CHATCHAT_QWEN3_VL_8B_MODEL_ID=/models/Qwen3-VL-8B-Instruct
CHATCHAT_QWEN3_32B_A3B_MODEL_ID=/models/Qwen3-32B-A3B

# Optional endpoint overrides. These defaults assume Nginx runs on the ChatChat host.
CHATCHAT_QWEN3_32B_BASE_URL=http://127.0.0.1:31000/v1
CHATCHAT_QWEN3_8_27B_BASE_URL=http://127.0.0.1:31002/v1
CHATCHAT_DEEPSEEK_V4_1_FLASH_BASE_URL=http://127.0.0.1:31005/v1
CHATCHAT_DEEPSEEK_V4_FLASH_INT8_BASE_URL=http://127.0.0.1:31002/v1
CHATCHAT_QWEN3_6_35B_A3B_BASE_URL=http://127.0.0.1:32004/v1
CHATCHAT_QWEN3_VL_8B_BASE_URL=http://127.0.0.1:32002/v1
CHATCHAT_QWEN3_32B_A3B_BASE_URL=http://127.0.0.1:32000/v1
