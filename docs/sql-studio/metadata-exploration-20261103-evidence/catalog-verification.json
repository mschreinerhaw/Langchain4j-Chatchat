            "key": "sql_datasource:MYSQL_TOP_TABLES_SIZE@c5c085c4-067b-4a0f-876c-e1c4f808232f",
            "title": "MySQL largest tables",
            "category": "maintenance_storage",
            "templateKey": "sql_datasource:MYSQL_TOP_TABLES_SIZE",
            "operationLevel": "read",
            "description": "Rank MySQL tables by total data and index size.",
            "assetName": "LiveData测试库_223",
            "revision": "2a19323a2c9df0ad3559927f2372b178c51829431d1ac9cb87c9b7a3605f3613",
            "assetRef": "c5c085c4-067b-4a0f-876c-e1c4f808232f",
            "sql": "SELECT table_schema,\n       table_name,\n       ROUND((data_length + index_length) / 1024 / 1024, 2) AS total_mb,\n       ROUND(data_length / 1024 / 1024, 2) AS data_mb,\n       ROUND(index_length / 1024 / 1024, 2) AS index_mb,\n       table_rows\nFROM information_schema.tables\nWHERE table_schema NOT IN ('information_schema', 'mysql', 'performance_schema', 'sys')\nORDER BY total_mb DESC\nLIMIT 50\n",
            "contentTruncated": false,
