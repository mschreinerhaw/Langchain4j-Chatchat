            },
            "key": "sql_datasource:MYSQL_DATABASE_SIZE@c5c085c4-067b-4a0f-876c-e1c4f808232f",
            "title": "MySQL database size",
            "category": "maintenance_storage",
            "templateKey": "sql_datasource:MYSQL_DATABASE_SIZE",
            "operationLevel": "read",
            "description": "Summarize MySQL database size by schema in megabytes.",
            "assetName": "LiveData测试库_223",
            "revision": "14be071303c2f3ddea6a8c62c53b705d1fa1842cccdd7c6575e3b85f3730f922",
            "assetRef": "c5c085c4-067b-4a0f-876c-e1c4f808232f",
            "sql": "SELECT table_schema AS db, SUM(data_length + index_length)/1024/1024 AS size_mb FROM information_schema.tables GROUP BY table_schema",
            "contentTruncated": false,
            "evidenceSource": "AUTHORIZED_TEMPLATE_ASSET_CATALOG",
            "referenceAuthority": "REFERENCE_ONLY_NOT_PHYSICAL_SCHEMA_OR_EXECUTION_AUTHORITY",
