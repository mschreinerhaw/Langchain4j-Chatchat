            "title": "MySQL instance variables",
            "category": "maintenance_instance",
            "templateKey": "sql_datasource:MYSQL_INSTANCE_VARIABLES",
            "operationLevel": "read",
            "description": "Read key MySQL instance variables for runtime configuration inspection.",
            "assetName": "LiveData测试库_223",
            "revision": "d9139018d7c0b9a10c79e2d6f72b3c044c6ac920b7fab9882e7e6fe58debf236",
            "assetRef": "c5c085c4-067b-4a0f-876c-e1c4f808232f",
            "sql": "SELECT variable_name, variable_value\nFROM performance_schema.global_variables\nWHERE variable_name IN (\n    'version',\n    'version_comment',\n    'max_connections',\n    'innodb_buffer_pool_size',\n    'innodb_flush_log_at_trx_commit',\n    'sync_binlog',\n    'slow_query_log',\n    'long_query_time',\n    'read_only',\n    'super_read_only'\n)\nORDER BY variable_name\n",
            "contentTruncated": false,
            "evidenceSource": "AUTHORIZED_TEMPLATE_ASSET_CATALOG",
            "referenceAuthority": "REFERENCE_ONLY_NOT_PHYSICAL_SCHEMA_OR_EXECUTION_AUTHORITY",
            "score": 1
