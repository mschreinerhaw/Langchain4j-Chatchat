{
  "id": "2b689c67-d343-3659-9b05-c753f0473b60",
  "code": "STUDIO_2B689C67D34336599B05C753F0473B60",
  "sqlTemplate": "-- tpcds monthly sales summary for a specific item\n-- Database: tpcds (test env 248)\n-- Placeholders (unquoted, substituted by template engine):\n--   {{product_id}}   – integer, ss_item_sk value (required)\n--   {{start_date}}   – date literal, inclusive start\n--   {{end_date}}     – date literal, inclusive end\n--   {{min_quantity}} – integer, minimum ss_quantity per row\n--   {{category}}     – string literal or NULL; NULL skips the category filter\n\nSELECT\n    d.d_year                           AS sale_year,\n    d.d_moy                            AS sale_month,\n    i.i_category                       AS category,\n    COUNT(*)                           AS row_count,\n    SUM(ss.ss_quantity)                AS total_quantity,\n    SUM(ss.ss_net_paid)                AS total_net_paid,\n    SUM(ss.ss_net_profit)              AS total_net_profit\nFROM tpcds.store_sales ss\nINNER JOIN tpcds.date_dim d\n        ON ss.ss_sold_date_sk = d.d_date_sk\nINNER JOIN tpcds.item i\n        ON ss.ss_item_sk = i.i_item_sk\nWHERE ss.ss_item_sk = {{product_id}}\n  AND d.d_date >= {{start_date}}\n  AND d.d_date <= {{end_date}}\n  AND ss.ss_quantity >= {{min_quantity}}\n  AND ({{category}} IS NULL OR i.i_category = {{category}})\nGROUP BY d.d_year,\n         d.d_moy,\n         i.i_category\nORDER BY d.d_year ASC,\n         d.d_moy ASC,\n         i.i_category ASC\nLIMIT 24;\n",
  "parameterSchema": {
    "type": "object",
    "properties": {
      "product_id": {
        "type": "integer",
        "minimum": 1,
        "default": 1,
        "description": "store_sales.ss_item_sk 商品主键"
      },
      "start_date": {
        "type": "string",
        "format": "date",
        "description": "date_dim.d_date 含边界起日"
      },
      "end_date": {
        "type": "string",
        "format": "date",
        "description": "date_dim.d_date 含边界止日"
      },
      "min_quantity": {
        "type": "integer",
        "minimum": 0,
        "default": 0,
        "description": "每行最低ss_quantity"
      },
      "category": {
        "type": [
          "string",
          "null"
        ],
        "default": null,
        "description": "item.i_category精确品类；NULL不过滤"
      }
    },
    "required": [
      "start_date",
      "end_date"
    ],
    "additionalProperties": false
  },
