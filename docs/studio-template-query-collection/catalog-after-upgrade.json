  {
    "key": "sql_datasource:STUDIO_FB8D154E3FE039E59A58FDDBBAE1CB1A",
    "assetType": "sql_datasource",
    "templateId": "STUDIO_FB8D154E3FE039E59A58FDDBBAE1CB1A",
    "title": "TPCDS 248 仓库期间库存快照",
    "description": "按仓库及含边界日期范围返回逐日库存快照。支持数量下限和可空类别筛选。数量单位未由来源声明，不作推断。",
    "category": "business_analysis",
    "businessCategoryCode": "business_analysis",
    "businessCategoryName": "business_analysis",
    "parameterSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "warehouse_id": {
          "type": "integer",
          "minimum": 1,
          "description": "仓库维表主键，无默认值"
        },
        "start_date": {
          "type": "string",
          "format": "date",
          "description": "含边界的库存快照开始日期"
        },
        "end_date": {
          "type": "string",
          "format": "date",
          "description": "含边界的库存快照结束日期"
        },
        "min_on_hand": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "现存数量下限"
        },
        "category": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "商品类别，null表示不限"
        }
      },
      "required": [
        "warehouse_id",
        "start_date",
        "end_date"
      ]
    },
    "queryFamily": "relational"
  },
  {
