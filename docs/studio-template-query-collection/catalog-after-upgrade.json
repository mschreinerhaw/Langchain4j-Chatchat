            "string",
            "null"
          ],
          "default": null,
          "description": "item.i_category精确品类；NULL不过滤"
        }
      },
      "required": [
        "start_date",
        "end_date"
      ],
      "additionalProperties": false
    },
    "queryFamily": "relational"
