    "businessCategoryCode": "market_data",
    "businessCategoryName": "市场行情",
    "parameterSchema": {
      "type": "object",
      "properties": {
        "security_code": {
          "description": "证券或指数代码，例如 000001、000001.SH。必须与采集数据中的 quote_code 完全一致。",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "security_code"
      ]
    },
    "queryFamily": "relational"
  },
