            "code": "STUDIO_271B4D6FA9283DBE9AA526D49F0BFFF7",
            "sqlTemplate": "-- 仓库面积筛选：w_warehouse_sq_ft 取原值（平方英尺），不做单位换算；{{min_area}} 为数值参数，代表最低面积阈值\nSELECT\n    w_warehouse_sk,\n    w_warehouse_name,\n    w_country,\n    w_state,\n    w_warehouse_sq_ft\nFROM tpcds.warehouse\nWHERE w_warehouse_sq_ft >= {{min_area}}\nORDER BY w_warehouse_sk;\n",
            "parameterSchema": {
              "type": "object",
              "properties": {
                "min_area": {
                  "type": "number",
                  "minimum": 0,
                  "default": 0,
                  "description": "最低面积字段原值，不换算单位"
                }
              },
              "additionalProperties": false
            },
