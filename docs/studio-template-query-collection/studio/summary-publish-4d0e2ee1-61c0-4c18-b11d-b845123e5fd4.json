  "code": "STUDIO_47B17C5B51BF39ACA93B4D2F1A8914CC",
  "sqlTemplate": "-- ============================================================================\n-- warehouse_summary.sql\n-- TPC-D S warehouse summary by country and state\n-- Dialect : MySQL\n-- Purpose : Group warehouses by country (w_country) and state (w_state),\n--           compute count and square-footage aggregates (SUM / MIN / MAX).\n-- Notes   : - NULL groups are preserved (MySQL GROUP BY keeps NULLs).\n--           - w_warehouse_sq_ft is kept as raw integer values; no unit\n--             conversion or guessing is applied.\n--           - Read-only; no parameters, no warehouse-id filters.\n-- Source  : tpcds.warehouse (REGISTERED_METADATA)\n-- ============================================================================\n\nSELECT\n    w_country,\n    w_state,\n    COUNT(*)                 AS warehouse_count,\n    SUM(w_warehouse_sq_ft)   AS total_warehouse_sq_ft,\n    MIN(w_warehouse_sq_ft)   AS min_warehouse_sq_ft,\n    MAX(w_warehouse_sq_ft)   AS max_warehouse_sq_ft\nFROM tpcds.warehouse\nGROUP BY\n    w_country,\n    w_state\nORDER BY\n    w_country,\n    w_state;\n",
  "parameterSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
