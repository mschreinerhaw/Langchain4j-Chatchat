+
+function assertNonNegativeSafeInteger(name: string, value: number): void {
+  if (typeof value !== 'number' || !Number.isSafeInteger(value) || value < 0) {
+    throw new TypeError(`${name} must be a non-negative safe integer`);
+  }
+}
+function assertBoundedSafeInteger(name: string, value: number, min: number, max: number): void {
+  if (typeof value !== 'number' || !Number.isSafeInteger(value) || value < min || value > max) {
+    throw new TypeError(`${name} must be a safe integer between ${min} and ${max}`);
+  }
+}
 
