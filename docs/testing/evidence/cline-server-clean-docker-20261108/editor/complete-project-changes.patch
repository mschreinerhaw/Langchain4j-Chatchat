+/** Query parameters accepted by `createMonitorClient().tasks(...)`. */
+export interface MonitorTaskQuery {
+  status?: TaskState;
+  q?: string;
+  /** Non-negative safe integer; omitted when not provided. */
+  offset?: number;
+  /** Safe integer in 1..500; omitted when not provided. */
+  limit?: number;
+}
+/** Parameters accepted by `createMonitorClient().events(taskId, after, limit)`. */
+export interface MonitorEventsQuery {
+  /** Non-negative safe integer cursor; defaults to 0. */
+  after: number;
+  /** Safe integer in 1..1000; defaults to 100. */
+  limit: number;
+}
--- /dev/null
+++ b/test/monitor-client-parameters.test.js
@@ -0,0 +1,180 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createMonitorClient } from '../src/monitor-client.ts';
+
+const taskId = 'a'.repeat(64);
+
+function recordingFetch() {
+  const calls = [];
+  const fn = async (url, init) => {
+    calls.push({ url, init });
+    return new Response(JSON.stringify({ schemaVersion: 'coding_agent.monitor.v1', total: 0, offset: 0, limit: 0, items: [], observedAt: new Date().toISOString() }), { status: 200, headers: { 'content-type': 'application/json' } });
+  };
+  fn.calls = calls;
+  return fn;
+}
+
+// --- baseUrl trailing slash normalization ---
+test('baseUrl with multiple trailing slashes collapses to a single separator', async () => {
+  const fetch = recordingFetch();
+  const client = createMonitorClient({ baseUrl: 'http://example.com///', token: 't'.repeat(32), fetch });
+  await client.node();
+  assert.equal(fetch.calls[0].url, 'http://example.com/v1/monitor/node');
+});
+
+test('baseUrl with no trailing slash works unchanged', async () => {
+  const fetch = recordingFetch();
+  const client = createMonitorClient({ baseUrl: 'http://example.com', token: 't'.repeat(32), fetch });
+  await client.node();
+  assert.equal(fetch.calls[0].url, 'http://example.com/v1/monitor/node');
+});
+
+test('baseUrl with a single trailing slash is preserved as one separator', async () => {
+  const fetch = recordingFetch();
+  const client = createMonitorClient({ baseUrl: 'http://example.com/', token: 't'.repeat(32), fetch });
+  await client.node();
+  assert.equal(fetch.calls[0].url, 'http://example.com/v1/monitor/node');
+});
+
+// --- tasks(query) parameter validation ---
+test('tasks() with no arguments issues /tasks without query string', async () => {
+  const fetch = recordingFetch();
+  const client = createMonitorClient({ baseUrl: 'http://example.com', token: 't'.repeat(32), fetch });
+  await client.tasks();
+  assert.equal(fetch.calls[0].url, 'http://example.com/v1/monitor/tasks');
+});
+
+test('tasks() with empty object issues /tasks without query string', async () => {
+  const fetch = recordingFetch();
+  const client = createMonitorClient({ baseUrl: 'http://example.com', token: 't'.repeat(32), fetch });
+  await client.tasks({});
+  assert.equal(fetch.calls[0].url, 'http://example.com/v1/monitor/tasks');
+});
+
+test('tasks() omits undefined offset and limit', async () => {
+  const fetch = recordingFetch();
+  const client = createMonitorClient({ baseUrl: 'http://example.com', token: 't'.repeat(32), fetch });
+  await client.tasks({ status: 'RUNNING', offset: undefined, limit: undefined });
+  assert.equal(fetch.calls[0].url, 'http://example.com/v1/monitor/tasks?status=RUNNING');
+});
+
+test('tasks() encodes q through URLSearchParams', async () => {
+  const fetch = recordingFetch();
+  const client = createMonitorClient({ baseUrl: 'http://example.com', token: 't'.repeat(32), fetch });
+  await client.tasks({ q: 'hello world&x=1', status: 'COMPLETED', offset: 0, limit: 10 });
+  const url = new URL(fetch.calls[0].url);
+  assert.equal(url.searchParams.get('q'), 'hello world&x=1');
+  assert.equal(url.searchParams.get('status'), 'COMPLETED');
+  assert.equal(url.searchParams.get('offset'), '0');
+  assert.equal(url.searchParams.get('limit'), '10');
+});
+
+test('tasks() accepts offset=0 and limit=1 (lower bounds)', async () => {
+  const fetch = recordingFetch();
+  const client = createMonitorClient({ baseUrl: 'http://example.com', token: 't'.repeat(32), fetch });
+  await client.tasks({ offset: 0, limit: 1 });
+  const url = new URL(fetch.calls[0].url);
+  assert.equal(url.searchParams.get('offset'), '0');
+  assert.equal(url.searchParams.get('limit'), '1');
+});
+
+test('tasks() accepts offset at MAX_SAFE_INTEGER and limit=500 (upper bounds)', async () => {
+  const fetch = recordingFetch();
+  const client = createMonitorClient({ baseUrl: 'http://example.com', token: 't'.repeat(32), fetch });
+  await client.tasks({ offset: Number.MAX_SAFE_INTEGER, limit: 500 });
+  const url = new URL(fetch.calls[0].url);
+  assert.equal(url.searchParams.get('offset'), String(Number.MAX_SAFE_INTEGER));
+  assert.equal(url.searchParams.get('limit'), '500');
+});
+
+
+for (const bad of [-1, -0.5, 0.5, 1.5, NaN, Infinity, -Infinity, Number.MAX_SAFE_INTEGER + 1, '0', null, true, [], {}]) {
+  test(`tasks() rejects invalid offset: ${String(bad)}`, async () => {
+    const fetch = recordingFetch();
+    const client = createMonitorClient({ baseUrl: 'http://example.com', token: 't'.repeat(32), fetch });
+    await assert.rejects(client.tasks({ offset: bad }), TypeError);
+    assert.equal(fetch.calls.length, 0, 'no network request should be issued');
+  });
+}
+
+for (const bad of [0, -1, 501, 0.5, 1.5, NaN, Infinity, -Infinity, Number.MAX_SAFE_INTEGER + 1, '1', null, true, [], {}]) {
+  test(`tasks() rejects invalid limit: ${String(bad)}`, async () => {
+    const fetch = recordingFetch();
+    const client = createMonitorClient({ baseUrl: 'http://example.com', token: 't'.repeat(32), fetch });
+    await assert.rejects(client.tasks({ limit: bad }), TypeError);
+    assert.equal(fetch.calls.length, 0, 'no network request should be issued');
+  });
+}
+
+// --- events(taskId, after, limit) parameter validation ---
+test('events() defaults to after=0 and limit=100', async () => {
+  const fetch = recordingFetch();
+  const client = createMonitorClient({ baseUrl: 'http://example.com', token: 't'.repeat(32), fetch });
+  await client.events(taskId);
+  assert.equal(fetch.calls[0].url, `http://example.com/v1/monitor/tasks/${taskId}/events?after=0&limit=100`);
+});
+
+test('events() accepts after=0 and limit=1 (lower bounds)', async () => {
+  const fetch = recordingFetch();
+  const client = createMonitorClient({ baseUrl: 'http://example.com', token: 't'.repeat(32), fetch });
+  await client.events(taskId, 0, 1);
+  assert.match(fetch.calls[0].url, /after=0&limit=1$/);
+});
+
+test('events() accepts after=MAX_SAFE_INTEGER and limit=1000 (upper bounds)', async () => {
+  const fetch = recordingFetch();
+  const client = createMonitorClient({ baseUrl: 'http://example.com', token: 't'.repeat(32), fetch });
+  await client.events(taskId, Number.MAX_SAFE_INTEGER, 1000);
+  assert.match(fetch.calls[0].url, new RegExp(`after=${Number.MAX_SAFE_INTEGER}&limit=1000$`));
+});
+
+for (const bad of [-1, -0.5, 0.5, 1.5, NaN, Infinity, -Infinity, Number.MAX_SAFE_INTEGER + 1, '0', null, true, [], {}]) {
+  test(`events() rejects invalid after: ${String(bad)}`, async () => {
+    const fetch = recordingFetch();
+    const client = createMonitorClient({ baseUrl: 'http://example.com', token: 't'.repeat(32), fetch });
+    await assert.rejects(client.events(taskId, bad), TypeError);
+    assert.equal(fetch.calls.length, 0, 'no network request should be issued');
+  });
+}
+
+for (const bad of [0, -1, 1001, 0.5, 1.5, NaN, Infinity, -Infinity, Number.MAX_SAFE_INTEGER + 1, '100', null, true, [], {}]) {
+  test(`events() rejects invalid limit: ${String(bad)}`, async () => {
+    const fetch = recordingFetch();
+    const client = createMonitorClient({ baseUrl: 'http://example.com', token: 't'.repeat(32), fetch });
+    await assert.rejects(client.events(taskId, 0, bad), TypeError);
+    assert.equal(fetch.calls.length, 0, 'no network request should be issued');
+  });
+}
+
+// --- observation ID validation still enforced ---
+test('events() still validates observation ID before parameter checks', async () => {
+  const fetch = recordingFetch();
+  const client = createMonitorClient({ baseUrl: 'http://example.com', token: 't'.repeat(32), fetch });
+  await assert.rejects(client.events('not-a-valid-id', 0, 100), TypeError);
+  assert.equal(fetch.calls.length, 0);
+});
+
+// --- successful response shape unchanged ---
+test('successful tasks() response shape is preserved', async () => {
+  const body = { schemaVersion: 'coding_agent.monitor.v1', observedAt: '2026-01-01T00:00:00Z', total: 1, offset: 0, limit: 10, items: [] };
+  const fetch = async () => new Response(JSON.stringify(body), { status: 200, headers: { 'content-type': 'application/json' } });
+  const client = createMonitorClient({ baseUrl: 'http://example.com', token: 't'.repeat(32), fetch });
+  const result = await client.tasks({ status: 'RUNNING', limit: 10 });
+  assert.deepEqual(result, body);
+});
+
+test('successful events() response shape is preserved', async () => {
+  const body = { schemaVersion: 'coding_agent.monitor.v1', items: [], nextCursor: 0, hasMore: false, truncated: false, earliestCursor: null };
+  const fetch = async () => new Response(JSON.stringify(body), { status: 200, headers: { 'content-type': 'application/json' } });
+  const client = createMonitorClient({ baseUrl: 'http://example.com', token: 't'.repeat(32), fetch });
+  const result = await client.events(taskId, 0, 100);
+  assert.deepEqual(result, body);
+});
+
+// --- authentication header preserved ---
+test('authorization header is preserved on valid requests', async () => {
+  const fetch = recordingFetch();
+  const client = createMonitorClient({ baseUrl: 'http://example.com', token: 'secret-token', fetch });
+  await client.tasks({ limit: 5 });
+  assert.equal(fetch.calls[0].init.headers.authorization, 'Bearer secret-token');
+});
