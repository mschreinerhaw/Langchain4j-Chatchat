--- /dev/null
+++ b/test/monitor-client-parameters.test.js
@@ -0,0 +1,219 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createMonitorClient } from '../dist/monitor-client.js';
+
+const OBSERVATION_ID = 'a'.repeat(64);
+
+/** Build a mock fetch that records the URL and returns a stub JSON body. */
+function mockFetch(body = {}) {
+  const calls = [];
+  const fn = async (url, init) => {
+    calls.push({ url: String(url), init });
+    return {
+      ok: true,
+      status: 200,
+      async json() { return body; },
+    };
+  };
+  return { fn, calls };
+}
+
+// ---- baseUrl trailing-slash normalization -----------------------------------
+
+for (const [label, baseUrl] of [
+  ['no trailing slash', 'http://example.com'],
+  ['one trailing slash', 'http://example.com/'],
+  ['three trailing slashes', 'http://example.com///'],
+  ['many trailing slashes', 'http://example.com//////'],
+]) {
+  test(`baseUrl: ${label} produces exactly one separator slash before /v1/monitor`, async () => {
+    const { fn, calls } = mockFetch({ schemaVersion: 'coding_agent.monitor.v1', instanceId: 'x' });
+    const client = createMonitorClient({ baseUrl, token: 't', fetch: fn });
+    await client.node();
+    assert.equal(calls.length, 1);
+    assert.equal(calls[0].url, 'http://example.com/v1/monitor/node');
+  });
+}
+
+// ---- tasks() parameter boundaries -------------------------------------------
+
+test('tasks() with no arguments issues /tasks without a query string', async () => {
+  const { fn, calls } = mockFetch({ schemaVersion: 'coding_agent.monitor.v1', items: [], total: 0, offset: 0, limit: 30 });
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  await client.tasks();
+  assert.equal(calls[0].url, 'http://h/v1/monitor/tasks');
+});
+
+test('tasks() with empty object issues /tasks without a query string', async () => {
+  const { fn, calls } = mockFetch({ schemaVersion: 'coding_agent.monitor.v1', items: [], total: 0, offset: 0, limit: 30 });
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  await client.tasks({});
+  assert.equal(calls[0].url, 'http://h/v1/monitor/tasks');
+});
+
+test('tasks() omits undefined fields from the query string', async () => {
+  const { fn, calls } = mockFetch({ schemaVersion: 'coding_agent.monitor.v1', items: [], total: 0, offset: 0, limit: 30 });
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  await client.tasks({ status: undefined, q: undefined, offset: undefined, limit: undefined });
+  assert.equal(calls[0].url, 'http://h/v1/monitor/tasks');
+});
+
+test('tasks() encodes q through URLSearchParams', async () => {
+  const { fn, calls } = mockFetch({ schemaVersion: 'coding_agent.monitor.v1', items: [], total: 0, offset: 0, limit: 30 });
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  await client.tasks({ q: 'aggregate & rollup=100%', status: 'RUNNING', offset: 0, limit: 20 });
+  const url = new URL(calls[0].url);
+  assert.equal(url.searchParams.get('q'), 'aggregate & rollup=100%');
+  assert.equal(url.searchParams.get('status'), 'RUNNING');
+  assert.equal(url.searchParams.get('offset'), '0');
+  assert.equal(url.searchParams.get('limit'), '20');
+});
+
+test('tasks() encodes q with Chinese and special characters', async () => {
+  const { fn, calls } = mockFetch({ schemaVersion: 'coding_agent.monitor.v1', items: [], total: 0, offset: 0, limit: 30 });
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  await client.tasks({ q: '汇总 任务/编号 #1' });
+  const url = new URL(calls[0].url);
+  assert.equal(url.searchParams.get('q'), '汇总 任务/编号 #1');
+});
+
+for (const limit of [1, 250, 500]) {
+  test(`tasks() accepts limit=${limit} (upper boundary)`, async () => {
+    const { fn, calls } = mockFetch({ schemaVersion: 'coding_agent.monitor.v1', items: [], total: 0, offset: 0, limit });
+    const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+    await client.tasks({ limit });
+    assert.equal(calls.length, 1);
+    assert.equal(new URL(calls[0].url).searchParams.get('limit'), String(limit));
+  });
+}
+
+for (const offset of [0, 1, Number.MAX_SAFE_INTEGER]) {
+  test(`tasks() accepts offset=${offset}`, async () => {
+    const { fn, calls } = mockFetch({ schemaVersion: 'coding_agent.monitor.v1', items: [], total: 0, offset, limit: 30 });
+    const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+    await client.tasks({ offset });
+    assert.equal(calls.length, 1);
+  });
+}
+
+for (const [label, query] of [
+  ['offset=-1', { offset: -1 }],
+  ['offset=NaN', { offset: NaN }],
+  ['offset=Infinity', { offset: Infinity }],
+  ['offset=-Infinity', { offset: -Infinity }],
+  ['offset=1.5 (fraction)', { offset: 1.5 }],
+  ['offset=MAX_SAFE_INTEGER+1', { offset: Number.MAX_SAFE_INTEGER + 1 }],
+  ['offset="0" (string)', { offset: '0' }],
+  ['offset=null', { offset: null }],
+  ['offset=true (boolean)', { offset: true }],
+  ['limit=0', { limit: 0 }],
+  ['limit=-1', { limit: -1 }],
+  ['limit=501', { limit: 501 }],
+  ['limit=NaN', { limit: NaN }],
+  ['limit=Infinity', { limit: Infinity }],
+  ['limit=1.5 (fraction)', { limit: 1.5 }],
+  ['limit="10" (string)', { limit: '10' }],
+  ['limit=null', { limit: null }],
+]) {
+  test(`tasks() rejects ${label} with TypeError before the request`, async () => {
+    const { fn, calls } = mockFetch();
+    const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+    assert.throws(() => client.tasks(query), TypeError);
+    assert.equal(calls.length, 0, 'no network request should be issued for invalid input');
+  });
+}
+
+// ---- events() parameter boundaries ------------------------------------------
+
+test('events() defaults: after=0, limit=100', async () => {
+  const body = { schemaVersion: 'coding_agent.monitor.v1', items: [], nextCursor: 0, hasMore: false, truncated: false, earliestCursor: null };
+  const { fn, calls } = mockFetch(body);
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  await client.events(OBSERVATION_ID);
+  const url = new URL(calls[0].url);
+  assert.equal(url.searchParams.get('after'), '0');
+  assert.equal(url.searchParams.get('limit'), '100');
+});
+
+for (const after of [0, 1, Number.MAX_SAFE_INTEGER]) {
+  test(`events() accepts after=${after}`, async () => {
+    const body = { schemaVersion: 'coding_agent.monitor.v1', items: [], nextCursor: 0, hasMore: false, truncated: false, earliestCursor: null };
+    const { fn, calls } = mockFetch(body);
+    const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+    await client.events(OBSERVATION_ID, after);
+    assert.equal(calls.length, 1);
+  });
+}
+
+for (const limit of [1, 500, 1000]) {
+  test(`events() accepts limit=${limit} (upper boundary)`, async () => {
+    const body = { schemaVersion: 'coding_agent.monitor.v1', items: [], nextCursor: 0, hasMore: false, truncated: false, earliestCursor: null };
+    const { fn, calls } = mockFetch(body);
+    const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+    await client.events(OBSERVATION_ID, 0, limit);
+    assert.equal(new URL(calls[0].url).searchParams.get('limit'), String(limit));
+  });
+}
+
+for (const [label, after, limit] of [
+  ['after=-1', -1, 100],
+  ['after=NaN', NaN, 100],
+  ['after=Infinity', Infinity, 100],
+  ['after=-Infinity', -Infinity, 100],
+  ['after=1.5 (fraction)', 1.5, 100],
+  ['after=MAX_SAFE_INTEGER+1', Number.MAX_SAFE_INTEGER + 1, 100],
+  ['after="0" (string)', '0', 100],
+  ['after=null', null, 100],
+  ['after=true (boolean)', true, 100],
+  ['limit=0', 0, 0],
+  ['limit=-1', 0, -1],
+  ['limit=1001', 0, 1001],
+  ['limit=NaN', 0, NaN],
+  ['limit=Infinity', 0, Infinity],
+  ['limit=1.5 (fraction)', 0, 1.5],
+  ['limit="100" (string)', 0, '100'],
+  ['limit=null', 0, null],
+]) {
+  test(`events() rejects ${label} with TypeError before the request`, async () => {
+    const { fn, calls } = mockFetch();
+    const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+    assert.throws(() => client.events(OBSERVATION_ID, after, limit), TypeError);
+    assert.equal(calls.length, 0, 'no network request should be issued for invalid input');
+  });
+}
+
+// ---- observation ID validation still applies --------------------------------
+
+test('events() still rejects malformed observation IDs before the request', async () => {
+  const { fn, calls } = mockFetch();
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  assert.throws(() => client.events('not-hex'), TypeError);
+  assert.equal(calls.length, 0);
+});
+
+// ---- successful response shape is unchanged ---------------------------------
+
+test('tasks() returns the parsed JSON body unchanged on success', async () => {
+  const body = { schemaVersion: 'coding_agent.monitor.v1', observedAt: '2026-01-01T00:00:00Z', total: 1, offset: 0, limit: 20, items: [{ id: 'x' }] };
+  const { fn } = mockFetch(body);
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  const result = await client.tasks({ limit: 20 });
+  assert.deepEqual(result, body);
+});
+
+test('events() returns the parsed JSON body unchanged on success', async () => {
+  const body = { schemaVersion: 'coding_agent.monitor.v1', items: [{ cursor: 1, timestamp: 't', type: 'X' }], nextCursor: 1, hasMore: false, truncated: false, earliestCursor: 1 };
+  const { fn } = mockFetch(body);
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  const result = await client.events(OBSERVATION_ID, 0, 50);
+  assert.deepEqual(result, body);
+});
+
+// ---- authentication header is preserved -------------------------------------
+
+test('client still sends the Bearer authorization header', async () => {
+  const { fn, calls } = mockFetch({ schemaVersion: 'coding_agent.monitor.v1', items: [], total: 0, offset: 0, limit: 30 });
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 'secret-token', fetch: fn });
+  await client.tasks({ limit: 1 });
+  assert.equal(calls[0].init.headers.authorization, 'Bearer secret-token');
+});