+const isSafeInteger = (value: unknown): value is number =>
+  typeof value === 'number' && Number.isFinite(value) && Number.isInteger(value) && Math.abs(value) <= Number.MAX_SAFE_INTEGER;
+
+const requireNonNegativeSafeInteger = (name: string, value: unknown): number => {
+  if (!isSafeInteger(value)) throw new TypeError(`${name} must be a non-negative safe integer`);
+  if ((value as number) < 0) throw new TypeError(`${name} must be a non-negative safe integer`);
+  return value as number;
+};
+
+const requireSafeIntegerInRange = (name: string, value: unknown, min: number, max: number): number => {
+  if (!isSafeInteger(value)) throw new TypeError(`${name} must be a safe integer between ${min} and ${max}`);
+  if ((value as number) < min || (value as number) > max) throw new TypeError(`${name} must be a safe integer between ${min} and ${max}`);
+  return value as number;
+};
 
