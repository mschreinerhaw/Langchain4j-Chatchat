 ```ts
 import { createMonitorClient } from './dist/monitor-client.js';
+import type { TaskQuery, TaskState, TaskSummary, TaskPage, MonitorEvent, NodeSnapshot } from './dist/monitor-types.js';
 
 // 在调用方服务端执行，token 从其 secret manager 读取。
 const node = createMonitorClient({ baseUrl: 'http://coding-agent-node:3100', token });
 const health = await node.node();
-const tasks = await node.tasks({ status: 'RUNNING', limit: 20 });
+const query: TaskQuery = { status: 'RUNNING', limit: 20 };
+const tasks = await node.tasks(query);
 if (tasks.items[0]) {
   const events = await node.events(tasks.items[0].id, 0, 100);
   // events.hasMore 时，用 nextCursor 继续；truncated 为 true 表示早期历史已淘汰。
 }
 ```
 
+客户端参数边界在发起请求前本地校验，无效输入抛出 `TypeError` 而不会触发网络请求：
+
+- `baseUrl` 允许多个尾随斜杠，最终请求路径只保留一个分隔斜杠。
+- `tasks(query)` 的 `offset` 若提供必须是非负安全整数；`limit` 若提供必须是 1–500 的安全整数；`undefined` 字段会被省略；`q` 通过 `URLSearchParams` 正确编码。
+- `events(taskId, after=0, limit=100)` 的 `after` 必须是非负安全整数；`limit` 必须是 1–1000 的安全整数。
+- 校验覆盖 `NaN`、`Infinity`、小数、负值、非安全整数及不合法类型。
+
+公开查询类型从 `monitor-types.ts` 命名导出，`monitor-client.ts` 通过 `export type *` 重导出，调用方可直接 `import type { TaskQuery } from 'runtime-os-cline-coding-adapter/monitor-client'`。
+
 建议 3–5 秒轮询，设置超时并保留最后成功快照。API 数据属于 `NODE_OBSERVATION_ONLY`，不应作为重试、扣费、停止证明或业务结果准入依据。入口应走反向代理的 `/monitor` 与 `/v1/monitor/` 白名单；HTTPS 时启用 Secure Cookie，执行接口保留在 Runtime 内网。
