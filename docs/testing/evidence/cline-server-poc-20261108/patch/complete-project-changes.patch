+function makeTransport(capture) {
+  const calls = [];
+  const transport = async (url, init) => {
+    calls.push({ url, init });
+    capture.calls = calls;
+    return new Response(JSON.stringify({ ok: true }), { status: 200, headers: { 'content-type': 'application/json' } });
+  };
+  capture.calls = calls;
+  return transport;
+}
+
+function makeClient(baseUrl, capture = {}) {
+  const transport = makeTransport(capture);
+  return { client: createMonitorClient({ baseUrl, token: 't'.repeat(32), fetch: transport }), capture };
+}
+
+test('baseUrl with multiple trailing slashes collapses to a single separator', async () => {
+  const { client, capture } = makeClient('http://example.com///');
+  await client.node();
+  assert.equal(capture.calls[0].url, 'http://example.com/v1/monitor/node');
+});
+
+test('baseUrl with a single trailing slash still produces one separator', async () => {
+  const { client, capture } = makeClient('http://example.com/');
+  await client.node();
+  assert.equal(capture.calls[0].url, 'http://example.com/v1/monitor/node');
+});
