+
+function assertNonNegativeSafeInteger(name: string, value: unknown): void {
+  if (typeof value !== 'number' || !Number.isSafeInteger(value) || value < 0) {
+    throw new TypeError(`${name} must be a non-negative safe integer`);
+  }
+}
+
+function assertBoundedSafeInteger(name: string, value: unknown, min: number, max: number): void {
+  if (typeof value !== 'number' || !Number.isSafeInteger(value) || value < min || value > max) {
+    throw new TypeError(`${name} must be a safe integer between ${min} and ${max}`);
+  }
+}
+
+function buildTasksQuery(query: MonitorTasksQuery): string {
+  if (query.offset !== undefined) assertNonNegativeSafeInteger('tasks.offset', query.offset);
+  if (query.limit !== undefined) assertBoundedSafeInteger('tasks.limit', query.limit, 1, 500);
+  const params = new URLSearchParams();
+  if (query.status !== undefined) params.set('status', query.status);
+  if (query.q !== undefined) params.set('q', query.q);
+  if (query.offset !== undefined) params.set('offset', String(query.offset));
+  if (query.limit !== undefined) params.set('limit', String(query.limit));
+  return params.toString();
+}
+
+function validateEventsArgs(after: number, limit: number): { after: number; limit: number } {
+  assertNonNegativeSafeInteger('events.after', after);
+  assertBoundedSafeInteger('events.limit', limit, 1, 1000);
+  return { after, limit };
+}
 
