+++ b/test/monitor-client-parameters.test.js
@@ -0,0 +1,259 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createMonitorClient } from '../dist/monitor-client.js';
+
+const OBSERVATION_ID = 'a'.repeat(64);
+
+function mockTransport(body = {}) {
+  const calls = [];
+  const fn = async (url, init) => {
+    calls.push({ url, init });
+    return { ok: true, status: 200, json: async () => body };
+  };
+  return { fn, calls };
+}
+
+// baseUrl trailing-slash normalisation
+test('baseUrl with no trailing slash produces a single separator slash', async () => {
+  const { fn, calls } = mockTransport({ schemaVersion: 'coding_agent.monitor.v1' });
+  const client = createMonitorClient({ baseUrl: 'http://host:3100', token: 't', fetch: fn });
+  await client.node();
+  assert.equal(calls[0].url, 'http://host:3100/v1/monitor/node');
+});
+
+test('baseUrl with one trailing slash produces a single separator slash', async () => {
+  const { fn, calls } = mockTransport({ schemaVersion: 'coding_agent.monitor.v1' });
+  const client = createMonitorClient({ baseUrl: 'http://host:3100/', token: 't', fetch: fn });
+  await client.node();
+  assert.equal(calls[0].url, 'http://host:3100/v1/monitor/node');
+});
+
+test('baseUrl with multiple trailing slashes collapses to a single separator slash', async () => {
+  const { fn, calls } = mockTransport({ schemaVersion: 'coding_agent.monitor.v1' });
+  const client = createMonitorClient({ baseUrl: 'http://host:3100///', token: 't', fetch: fn });
+  await client.node();
+  assert.equal(calls[0].url, 'http://host:3100/v1/monitor/node');
+});
+
+test('tasks URL is correctly joined when baseUrl has trailing slashes', async () => {
+  const { fn, calls } = mockTransport({ schemaVersion: 'coding_agent.monitor.v1', total: 0, offset: 0, limit: 20, items: [], observedAt: '' });
+  const client = createMonitorClient({ baseUrl: 'http://host:3100////', token: 't', fetch: fn });
+  await client.tasks({ limit: 20 });
+  assert.equal(calls[0].url, 'http://host:3100/v1/monitor/tasks?limit=20');
+});
+
+
+// tasks() — valid boundary values
+test('tasks() with no arguments sends a bare /tasks path (no query string)', async () => {
+  const { fn, calls } = mockTransport({ schemaVersion: 'coding_agent.monitor.v1', total: 0, offset: 0, limit: 20, items: [], observedAt: '' });
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  await client.tasks();
+  assert.equal(calls[0].url, 'http://h/v1/monitor/tasks');
+});
+
+test('tasks() with empty object sends a bare /tasks path', async () => {
+  const { fn, calls } = mockTransport({ schemaVersion: 'coding_agent.monitor.v1', total: 0, offset: 0, limit: 20, items: [], observedAt: '' });
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  await client.tasks({});
+  assert.equal(calls[0].url, 'http://h/v1/monitor/tasks');
+});
+
+test('tasks() omits undefined fields from the query string', async () => {
+  const { fn, calls } = mockTransport({ schemaVersion: 'coding_agent.monitor.v1', total: 0, offset: 0, limit: 20, items: [], observedAt: '' });
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  await client.tasks({ status: undefined, q: undefined, offset: undefined, limit: undefined });
+  assert.equal(calls[0].url, 'http://h/v1/monitor/tasks');
+});
+
+test('tasks() accepts offset=0 (lower boundary)', async () => {
+  const { fn, calls } = mockTransport({ schemaVersion: 'coding_agent.monitor.v1', total: 0, offset: 0, limit: 20, items: [], observedAt: '' });
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  await client.tasks({ offset: 0 });
+  assert.match(calls[0].url, /offset=0/);
+});
+
+test('tasks() accepts limit=1 (lower boundary)', async () => {
+  const { fn, calls } = mockTransport({ schemaVersion: 'coding_agent.monitor.v1', total: 0, offset: 0, limit: 1, items: [], observedAt: '' });
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  await client.tasks({ limit: 1 });
+  assert.match(calls[0].url, /limit=1/);
+});
+
+test('tasks() accepts limit=500 (upper boundary)', async () => {
+  const { fn, calls } = mockTransport({ schemaVersion: 'coding_agent.monitor.v1', total: 0, offset: 0, limit: 500, items: [], observedAt: '' });
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  await client.tasks({ limit: 500 });
+  assert.match(calls[0].url, /limit=500/);
+});
+
+// tasks() — query encoding
+test('tasks() encodes q with URLSearchParams (spaces, ampersands, unicode)', async () => {
+  const { fn, calls } = mockTransport({ schemaVersion: 'coding_agent.monitor.v1', total: 0, offset: 0, limit: 20, items: [], observedAt: '' });
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  await client.tasks({ q: 'hello world&foo=bar' });
+  const url = new URL(calls[0].url);
+  assert.equal(url.searchParams.get('q'), 'hello world&foo=bar');
+});
+
+test('tasks() combines status, q, offset and limit in the query string', async () => {
+  const { fn, calls } = mockTransport({ schemaVersion: 'coding_agent.monitor.v1', total: 0, offset: 0, limit: 20, items: [], observedAt: '' });
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  await client.tasks({ status: 'RUNNING', q: 'alpha', offset: 10, limit: 25 });
+  const url = new URL(calls[0].url);
+  assert.equal(url.searchParams.get('status'), 'RUNNING');
+  assert.equal(url.searchParams.get('q'), 'alpha');
+  assert.equal(url.searchParams.get('offset'), '10');
+  assert.equal(url.searchParams.get('limit'), '25');
+
+// tasks() — invalid offset
+for (const [label, value] of [
+  ['negative', -1],
+  ['NaN', NaN],
+  ['Infinity', Infinity],
+  ['negative Infinity', -Infinity],
+  ['decimal', 1.5],
+  ['string', '0'],
+  ['null', null],
+  ['boolean', true],
+  ['beyond safe integer', Number.MAX_SAFE_INTEGER + 1],
+]) {
+  test(`tasks() rejects offset=${label} without sending a request`, () => {
+    const { fn, calls } = mockTransport();
+    const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+    assert.throws(() => client.tasks({ offset: value }), TypeError);
+    assert.equal(calls.length, 0);
+  });
+}
+
+// tasks() — invalid limit
+for (const [label, value] of [
+  ['zero', 0],
+  ['above 500', 501],
+  ['negative', -1],
+  ['NaN', NaN],
+  ['Infinity', Infinity],
+  ['decimal', 2.5],
+  ['string', '10'],
+  ['null', null],
+  ['beyond safe integer', Number.MAX_SAFE_INTEGER + 1],
+]) {
+  test(`tasks() rejects limit=${label} without sending a request`, () => {
+    const { fn, calls } = mockTransport();
+    const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+    assert.throws(() => client.tasks({ limit: value }), TypeError);
+    assert.equal(calls.length, 0);
+  });
+}
+
+
+// events() — valid boundary values
+const eventsBody = { schemaVersion: 'x', items: [], nextCursor: 0, hasMore: false, truncated: false, earliestCursor: null };
+
+test('events() defaults to after=0 and limit=100', async () => {
+  const { fn, calls } = mockTransport(eventsBody);
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  await client.events(OBSERVATION_ID);
+  assert.match(calls[0].url, /after=0&limit=100/);
+});
+
+test('events() accepts after=0 (lower boundary)', async () => {
+  const { fn, calls } = mockTransport(eventsBody);
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  await client.events(OBSERVATION_ID, 0, 100);
+  assert.match(calls[0].url, /after=0/);
+});
+
+test('events() accepts limit=1 (lower boundary)', async () => {
+  const { fn, calls } = mockTransport(eventsBody);
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  await client.events(OBSERVATION_ID, 0, 1);
+  assert.match(calls[0].url, /limit=1/);
+});
+
+test('events() accepts limit=1000 (upper boundary)', async () => {
+  const { fn, calls } = mockTransport(eventsBody);
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  await client.events(OBSERVATION_ID, 0, 1000);
+  assert.match(calls[0].url, /limit=1000/);
+});
+
+test('events() accepts a large safe-integer cursor for after', async () => {
+  const { fn, calls } = mockTransport(eventsBody);
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  await client.events(OBSERVATION_ID, Number.MAX_SAFE_INTEGER, 10);
+  assert.match(calls[0].url, /after=9007199254740991/);
+});
+
+// events() — invalid after
+for (const [label, value] of [
+  ['negative', -1],
+  ['NaN', NaN],
+  ['Infinity', Infinity],
+  ['negative Infinity', -Infinity],
+  ['decimal', 0.5],
+  ['string', '0'],
+  ['null', null],
+  ['boolean', false],
+  ['beyond safe integer', Number.MAX_SAFE_INTEGER + 1],
+]) {
+  test(`events() rejects after=${label} without sending a request`, () => {
+    const { fn, calls } = mockTransport();
+    const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+    assert.throws(() => client.events(OBSERVATION_ID, value, 10), TypeError);
+    assert.equal(calls.length, 0);
+  });
+}
+
+// events() — invalid limit
+for (const [label, value] of [
+  ['zero', 0],
+  ['above 1000', 1001],
+  ['negative', -1],
+  ['NaN', NaN],
+  ['Infinity', Infinity],
+  ['decimal', 50.5],
+  ['string', '100'],
+  ['null', null],
+  ['beyond safe integer', Number.MAX_SAFE_INTEGER + 1],
+]) {
+  test(`events() rejects limit=${label} without sending a request`, () => {
+    const { fn, calls } = mockTransport();
+    const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+    assert.throws(() => client.events(OBSERVATION_ID, 0, value), TypeError);
+    assert.equal(calls.length, 0);
+  });
+}
+
+
+// Existing behaviour is preserved: observation ID validation & auth header
+test('task() still rejects malformed observation IDs', () => {
+  const { fn, calls } = mockTransport();
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  assert.throws(() => client.task('not-a-valid-id'), TypeError);
+  assert.equal(calls.length, 0);
+});
+
+test('successful requests still carry the Bearer authorization header', async () => {
+  const { fn, calls } = mockTransport({ schemaVersion: 'coding_agent.monitor.v1' });
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 'secret-token', fetch: fn });
+  await client.node();
+  assert.equal(calls[0].init.headers.authorization, 'Bearer secret-token');
+});
+
+test('successful tasks response shape is unchanged', async () => {
+  const body = { schemaVersion: 'coding_agent.monitor.v1', observedAt: 'now', total: 1, offset: 0, limit: 20, items: [{ id: 'x' }] };
+  const { fn } = mockTransport(body);
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  const result = await client.tasks();
+  assert.deepEqual(result, body);
+});
+
+test('successful events response shape is unchanged', async () => {
+  const body = { schemaVersion: 'x', items: [{ cursor: 1, timestamp: 't', type: 'E' }], nextCursor: 2, hasMore: true, truncated: false, earliestCursor: 1 };
+  const { fn } = mockTransport(body);
+  const client = createMonitorClient({ baseUrl: 'http://h', token: 't', fetch: fn });
+  const result = await client.events(OBSERVATION_ID, 0, 50);
+  assert.deepEqual(result, body);
+});
+
+});
