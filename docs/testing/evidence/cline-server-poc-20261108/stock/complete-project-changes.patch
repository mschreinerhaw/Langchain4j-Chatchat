 const health = await node.node();
-const tasks = await node.tasks({ status: 'RUNNING', limit: 20 });
+
+const query: MonitorTasksQuery = { status: 'RUNNING', limit: 20 };
+const tasks = await node.tasks(query);
 if (tasks.items[0]) {
-  const events = await node.events(tasks.items[0].id, 0, 100);
+  const events: MonitorEventsPage = await node.events(tasks.items[0].id, 0, 100);
