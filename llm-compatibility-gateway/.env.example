# Replace placeholders before launch. Do not commit .env.
ADMIN_PASSWORD=
GATEWAY_API_KEY=
CONFIG_ENCRYPTION_KEY=
UPSTREAM_ALLOWED_ORIGINS=http://10.2.25.111:32004
# GATEWAY_CLIENTS='[{"id":"cline","key":"<separate-random-key>","models":["qwen3.6-35b-a3b"]}]'
# GATEWAY_CLIENTS='[{"id":"runtime-os","key":"<separate-random-key>","models":["qwen3.6-35b-a3b"],"profile":"cline","mode":"runtime_managed"}]'
# GATEWAY_MAX_CONCURRENCY=32
# GATEWAY_MAX_REQUEST_BYTES=8388608
# GATEWAY_MAX_RESPONSE_BYTES=8000000
# GATEWAY_MAX_STREAM_BYTES=134217728
# GATEWAY_MAX_SSE_EVENT_BYTES=2000000
# GATEWAY_DIAGNOSTIC_FIRST_MS=15000
# GATEWAY_DIAGNOSTIC_IDLE_MS=15000
# GATEWAY_SHUTDOWN_DRAIN_MS=25000
# GATEWAY_STOP_GRACE_PERIOD=35s
TLS_SERVER_NAMES=llm-gateway.example.com
# 内网无 CA 且启动目录为空时，显式设为 true 以生成自签服务器证书。
TLS_SELF_SIGNED=false
TLS_BOOTSTRAP_HOST_DIR=./tls-bootstrap
HTTPS_PORT=8443
HTTPS_PUBLIC_PORT=8443
API_BIND=127.0.0.1
ADMIN_BIND=127.0.0.1
ADMIN_PUBLIC_PORT=18081
