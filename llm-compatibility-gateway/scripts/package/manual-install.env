GATEWAY_ROOT=${GATEWAY_ROOT:-/opt/llm-compatibility-gateway}
GATEWAY_PROJECT=${GATEWAY_PROJECT:-llm-gateway}
GATEWAY_HOST=${GATEWAY_HOST:-}
GATEWAY_BIND=${GATEWAY_BIND:-0.0.0.0}
GATEWAY_HTTPS_PORT=${GATEWAY_HTTPS_PORT:-8443}
GATEWAY_ADMIN_PORT=${GATEWAY_ADMIN_PORT:-18081}
GATEWAY_ENABLE_HTTP=${GATEWAY_ENABLE_HTTP:-true}
GATEWAY_HTTP_BIND=${GATEWAY_HTTP_BIND:-$GATEWAY_BIND}
GATEWAY_HTTP_PORT=${GATEWAY_HTTP_PORT:-18080}
